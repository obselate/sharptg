<Project Sdk="Gsharp.NET.Sdk/0.4.59">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Tgtui</RootNamespace>
    <AssemblyName>tgtui</AssemblyName>
    <Version>0.1.0</Version>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <StripSymbols>true</StripSymbols>
    <SharpTuiProject Condition="'$(SharpTuiProject)' == ''">../sharptui/SharpTui.Framework.gsproj</SharpTuiProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(SharpTuiProject)" />
  </ItemGroup>

</Project>
